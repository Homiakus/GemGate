[Unit]
Description=GemGate Gemini API gateway
After=network-online.target
Wants=network-online.target

[Service]
User=gemgate
Group=gemgate
WorkingDirectory=/opt/gemgate
EnvironmentFile=/etc/gemgate/gemgate.env
ExecStart=/opt/gemgate/gemgate serve -config /etc/gemgate/config.yaml
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gemgate

[Install]
WantedBy=multi-user.target
